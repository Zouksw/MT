{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "backend": {
      "entry": [
        "src/server.ts",
        "src/test-setup.ts",
        "prisma/seed.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignore": [
        "dist/**",
        "generated/**"
      ],
      "ignoreBinaries": ["prisma", "tsx", "tsc-alias"]
    },
    "frontend": {
      "entry": [
        "src/app/**/{layout,page,loading,error,not-found,template,default}.tsx",
        "src/app/**/route.ts",
        "next.config.mjs",
        "jest.config.js",
        "jest.setup.js",
        "playwright.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "*.config.{js,mjs,ts}"],
      "ignore": [".next/**"],
      "ignoreBinaries": ["next"]
    }
  }
}
